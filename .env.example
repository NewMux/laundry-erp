# ─────────────────────────────────────────────────────────────────────────────
# Vercel + Supabase: every environment variable the app reads.
# Set these in Vercel → Project → Settings → Environment Variables (never commit
# real values). Docker/Coolify uses deploy/.env.example instead; local dev uses
# apps/api/.env.example. Details: docs/DEPLOYMENT.md → "Vercel + Supabase".
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Supabase → Connect) -------------------------------------------
# Runtime queries: the transaction pooler (Supavisor), port 6543, with pgbouncer=true
# (Prisma then avoids prepared statements, which transaction pooling cannot keep).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations (build step): a session connection on port 5432.
# Vercel has no IPv6, and the direct host db.[PROJECT-REF].supabase.co is IPv6-only
# unless you buy Supabase's IPv4 add-on, so use the *session pooler* here:
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#   …or, with the IPv4 add-on, the direct connection:
#   DIRECT_URL=postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- App ---------------------------------------------------------------------
# Signs public receipt/statement links. openssl rand -hex 32
APP_SECRET=
# Public HTTPS address (receipt QR codes, WhatsApp and statement links), no trailing slash.
# Optional on Vercel: defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_URL=https://your-project.vercel.app
# Ghassla platform super admin, created by the build if none exists yet. In production the
# password must be 12+ characters and not a well-known default, or the build fails.
SUPERADMIN_EMAIL=admin@newmux.com
SUPERADMIN_PASSWORD=
# Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/*. openssl rand -hex 32
CRON_SECRET=
# Customer app sign-in codes: sent by WhatsApp, with SMS as the fallback (WHATSAPP_* / TWILIO_* in the
# deployment guide). Set either or both. With neither, codes are only written to the server log in
# development; in production sign-in is then switched off, except for any pilot numbers.
# Test / staging only: a fixed code replaces sending. The app refuses to start in production with it set
# (it would let anyone sign in as any customer).
CUSTOMER_OTP_DEV_CODE=
# WhatsApp Cloud API (Meta). Template category must be AUTHENTICATION: body "{{1}}" = the code,
# with a "copy code" button. Language is the one the template was approved in (en, ar, …).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_OTP_LANGUAGE=en
# SMS through Twilio: set TWILIO_FROM (number or approved sender ID) or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Pilot, no SMS provider yet: a few known phone numbers (staff and friendly customers of the first
# laundry) sign in with a fixed 6-digit code that only you know; no message is sent. Both are needed.
# Everyone else gets a normal code (logged only, until a provider is set). Remove both when real
# SMS is live, and change the code if it is ever shared more widely than intended.
CUSTOMER_OTP_PILOT_NUMBERS=
CUSTOMER_OTP_PILOT_CODE=
# Public signup (/signup, 14-day free trial) is OFF by default: Ghassla creates each laundry's account
# after it has paid (platform admin). Set to true only to let anyone create an account themselves.
PUBLIC_SIGNUP=false
# Bot check on public signup (Cloudflare Turnstile, free). Create a widget in the Cloudflare dashboard
# (Turnstile), then set both keys. With either missing the check is off.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Email for password reset links (Resend, https://resend.com). MAIL_FROM must be on a domain verified
# in Resend, e.g. "Ghassla <no-reply@ghassla.com>". With either missing no email is sent and owners
# are reset by hand (Settings > Users, or the platform admin's "Reset link" on the shop).
RESEND_API_KEY=
MAIL_FROM=
# Abuse limits (every code is a paid message). All optional; the values shown are the defaults.
# Countries codes may be sent to, as dial codes; "*" allows any. Default: Bahrain, UAE, Saudi Arabia,
# Kuwait, Oman, Qatar (with their mobile-number lengths).
CUSTOMER_OTP_COUNTRIES=973,971,966,965,968,974
# Per phone number per 24 h (there is also a fixed 5 per 10 minutes) and per source IP per hour.
CUSTOMER_OTP_MAX_PER_PHONE_DAY=10
CUSTOMER_OTP_MAX_PER_IP_HOUR=10
# Circuit breakers across all customers: past these, no code is sent until the hour / day clears.
# Size them to your real sign-ups; they bound the cost of an attack.
CUSTOMER_OTP_MAX_PER_HOUR=300
CUSTOMER_OTP_MAX_PER_DAY=1000

# --- Uploaded files (Supabase Storage) ---------------------------------------
# Project URL and the secret / service_role key (Supabase → Project Settings → API Keys).
# Server-side only: never expose this key to the browser.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket, created by the build if missing.
SUPABASE_STORAGE_BUCKET=uploads

# --- Build step (apps/api/scripts/vercel-build.ts) ---------------------------
# Migrations + setup run on Production builds only. Set true on a Preview
# environment that has its own database; false to run migrations yourself.
MIGRATE_ON_BUILD=
# true creates the "demo" shop (staging/test databases only, never production).
SEED_DEMO=false

# --- Optional ----------------------------------------------------------------
# Secure cookies; defaults to true on Vercel.
COOKIE_SECURE=
# "local" (UPLOAD_DIR) or "supabase"; defaults to supabase when SUPABASE_URL is set.
STORAGE_DRIVER=
# Fastify log level (info).
LOG_LEVEL=
# Any value logs every SQL query.
PRISMA_LOG=

# Docker-only, ignored on Vercel: PORT, UPLOAD_DIR, CHROMIUM_PATH, WEB_DIST,
# RUN_MIGRATIONS, and the backup container's POSTGRES_* / STORAGEBOX_* / RESTIC_*.
