# ─────────────────────────────────────────────────────────────────────────────
# Vercel + Supabase: every environment variable the app reads.
# Set these in Vercel → Project → Settings → Environment Variables (never commit
# real values). Docker/Coolify uses deploy/.env.example instead; local dev uses
# apps/api/.env.example. Details: docs/DEPLOYMENT.md → "Vercel + Supabase".
# ─────────────────────────────────────────────────────────────────────────────

# --- Database (Supabase → Connect) -------------------------------------------
# Runtime queries: the transaction pooler (Supavisor), port 6543, with pgbouncer=true
# (Prisma then avoids prepared statements, which transaction pooling cannot keep).
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations (build step): a session connection on port 5432.
# Vercel has no IPv6, and the direct host db.[PROJECT-REF].supabase.co is IPv6-only
# unless you buy Supabase's IPv4 add-on, so use the *session pooler* here:
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#   …or, with the IPv4 add-on, the direct connection:
#   DIRECT_URL=postgresql://postgres:[DB-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- App ---------------------------------------------------------------------
# Signs public receipt/statement links. openssl rand -hex 32
APP_SECRET=
# Public HTTPS address (receipt QR codes, WhatsApp and statement links), no trailing slash.
# Optional on Vercel: defaults to https://$VERCEL_PROJECT_PRODUCTION_URL.
PUBLIC_URL=https://your-project.vercel.app
# NewMux platform super admin, created by the build if none exists yet.
SUPERADMIN_EMAIL=admin@newmux.com
SUPERADMIN_PASSWORD=
# Vercel Cron sends it as "Authorization: Bearer …" to /api/cron/*. openssl rand -hex 32
CRON_SECRET=
# Customer app sign-in codes. No SMS provider is connected yet, so codes are written to
# the server log. For test / staging only, set a fixed code instead (never in production).
CUSTOMER_OTP_DEV_CODE=

# --- Uploaded files (Supabase Storage) ---------------------------------------
# Project URL and the secret / service_role key (Supabase → Project Settings → API Keys).
# Server-side only: never expose this key to the browser.
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket, created by the build if missing.
SUPABASE_STORAGE_BUCKET=uploads

# --- Build step (apps/api/scripts/vercel-build.ts) ---------------------------
# Migrations + setup run on Production builds only. Set true on a Preview
# environment that has its own database; false to run migrations yourself.
MIGRATE_ON_BUILD=
# true creates the "demo" shop (staging/test databases only, never production).
SEED_DEMO=false

# --- Optional ----------------------------------------------------------------
# Secure cookies; defaults to true on Vercel.
COOKIE_SECURE=
# "local" (UPLOAD_DIR) or "supabase"; defaults to supabase when SUPABASE_URL is set.
STORAGE_DRIVER=
# Fastify log level (info).
LOG_LEVEL=
# Any value logs every SQL query.
PRISMA_LOG=

# Docker-only, ignored on Vercel: PORT, UPLOAD_DIR, CHROMIUM_PATH, WEB_DIST,
# RUN_MIGRATIONS, and the backup container's POSTGRES_* / STORAGEBOX_* / RESTIC_*.
