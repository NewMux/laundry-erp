# PostgreSQL connection
DATABASE_URL=postgresql://laundry:laundry@localhost:5432/laundry
# Connection for migrations (prisma migrate). Leave empty with a single local
# Postgres: `npm run db:migrate` uses DATABASE_URL. On Supabase see /.env.example.
DIRECT_URL=
# Random 32+ char secret used to sign public receipt links
APP_SECRET=change-me-to-a-long-random-string
# Public base URL (used in receipt QR codes / WhatsApp links)
PUBLIC_URL=http://localhost:5173
PORT=3000
# Where uploaded files are stored (mount a persistent volume here)
UPLOAD_DIR=./uploads
# Chromium used for server-side PDFs (A4 invoices, statements, payslips, reports)
CHROMIUM_PATH=
# Platform super admin created on first start (if no super admin exists)
SUPERADMIN_EMAIL=admin@newmux.com
SUPERADMIN_PASSWORD=ChangeMe123!
# Set to "true" behind HTTPS so cookies are Secure
COOKIE_SECURE=false
# Optional: enables the /api/cron/* job endpoints (Vercel Cron). Docker runs the jobs in-process.
CRON_SECRET=
# Optional: keep uploads in Supabase Storage instead of UPLOAD_DIR
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads
