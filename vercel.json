{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["syd1"],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "headers": [
        { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
        { "source": "/(sw.js|index.html|manifest.webmanifest)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
      ],
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/vercel.ts",
      "buildCommand": "npm run vercel-build",
      "functions": {
        "src/vercel.ts": {
          "maxDuration": 60,
          "regions": ["syd1"],
          "includeFiles": "{node_modules/@sparticuz/chromium/bin/**,node_modules/@fontsource/noto-sans*/files/*-{latin,latin-ext,devanagari,arabic}-{400,700}-normal.woff2}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [
    { "path": "/api/cron/recurring-expenses", "schedule": "5 21 * * *" },
    { "path": "/api/cron/package-expiry", "schedule": "15 21 * * *" },
    { "path": "/api/cron/session-cleanup", "schedule": "25 21 * * *" }
  ]
}
