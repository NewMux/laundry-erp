# Copy to .env next to docker-compose.yml (or enter these in Coolify → Environment Variables).

# Public HTTPS address of the app (used in receipt QR codes, WhatsApp and statement links)
PUBLIC_URL=https://app.example.com
# Long random string: openssl rand -hex 32
APP_SECRET=
# Database password (letters and digits only — it is embedded in a URL)
POSTGRES_PASSWORD=
# NewMux platform super admin, created on first start
SUPERADMIN_EMAIL=admin@newmux.com
SUPERADMIN_PASSWORD=
# true only on a staging server: creates the "demo" shop
SEED_DEMO=false

# --- Nightly backups to a Hetzner Storage Box ---
# Storage Box → Settings: enable "SSH support"; add the public key to .ssh/authorized_keys on the box.
STORAGEBOX_HOST=u123456.your-storagebox.de
STORAGEBOX_USER=u123456
STORAGEBOX_PATH=laundry-backups
# base64 -w0 < ~/.ssh/laundry_backup
STORAGEBOX_SSH_KEY_B64=
# Encrypts the backups. Store it in a password manager: without it backups cannot be restored.
RESTIC_PASSWORD=
# Cron in Asia/Bahrain time (default 03:00 every night)
BACKUP_SCHEDULE=0 3 * * *
# Optional dead-man switch (e.g. healthchecks.io) pinged after each successful backup
BACKUP_HEALTHCHECK_URL=
